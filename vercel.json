{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)\\.(env|git|sql|bak|log|txt|json|config|settings|backup|password|dump)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ],
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)(curl|python|bot|spider|scan)"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)\\.(env|git|sql|bak|log|txt|json|config|settings|backup|password|dump)",
      "destination": "/404.html"
    }
  ]
}